# Aura environment template — copy to .env for local use (.env is gitignored).
#
# Aura uses NO static AWS credentials. CI authenticates via GitHub OIDC, and
# local runs use your normal AWS CLI auth (SSO session or a named profile).
# Do not put access keys here.

# AWS region for all resources.
AWS_REGION=us-east-1

# Local AWS CLI auth: an SSO session or a named profile (run `aws sso login`
# or `aws configure --profile <name>`). No long-lived keys required.
AWS_PROFILE=default

# The IAM role GitHub Actions assumes via OIDC. Set the actual value as the
# repository secret AWS_ROLE_ARN — this is only a reference for local context.
# AWS_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/<OIDC_ROLE_NAME>

# EKS cluster name (must match terraform/environments/dev/variables.tf).
CLUSTER_NAME=aura-eks-dev
